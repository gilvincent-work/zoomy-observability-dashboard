# Supabase read access for the dashboard — ANON key only.
# NEVER put the service-role key here: it bypasses RLS and must never reach a
# browser. The batch job (zoomy-observability) owns writes with the service role;
# this app only reads digest_archive via the anon key + an RLS read policy.
# Leave these unset to run against built-in mock digests.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
