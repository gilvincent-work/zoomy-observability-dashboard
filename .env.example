# Server-side read of the digest_archive table in the OBSERVABILITY Supabase
# project. These are SERVER-ONLY — do NOT prefix with NEXT_PUBLIC_, and never
# expose the service-role key to the browser. The table is not anon-readable
# (its bundle column holds verbatim customer quotes); the dashboard reads it in a
# Server Component with the service-role key and selects only the digest column.
# In Vercel, set these as (non-public) Environment Variables.
# Leave unset to run against built-in mock digests.
SUPABASE_URL_ARCHIVE=https://your-observability-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY_ARCHIVE=your-archive-service-role-key

# Local dev only: skip Google sign-in so `next dev` loads straight into the
# dashboard. Ignored unless NODE_ENV is development, so it can never take effect
# on a Vercel deployment. Leave unset (or false) to require real sign-in.
# DEV_AUTH_BYPASS=true
